# Qwen 2.5 Coder Configuration

# Ollama Configuration
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODELS_DIR=/root/.ollama/models
OLLAMA_KEEP_ALIVE=5m

# Model Configuration
MODEL_NAME=qwen2.5-coder:7b-abliterated
MODEL_TEMPERATURE=0.7
MODEL_TOP_P=0.9
MODEL_TOP_K=40
MODEL_REPEAT_PENALTY=1.1
MODEL_NUM_PREDICT=2048
MODEL_NUM_CTX=4096

# API Configuration
API_TIMEOUT=300
API_MAX_RETRIES=3
API_RETRY_DELAY=1000

# Performance
USE_GPU=true
GPU_LAYERS=auto
THREADS=auto
BATCH_SIZE=32

# Logging
LOG_LEVEL=info
LOG_FILE=/tmp/qwen-coder.log

# Development
DEBUG=false
DEVELOPMENT_MODE=true
